{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "HotelManagementSystemSecretKey2026_SecureMinimum32CharsLength!",
    "Issuer": "HotelMS",
    "Audience": "HotelMSClients",
    "ExpiryInMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "hotel-rooms-route": {
        "ClusterId": "hotel-cluster",
        "Match": {
          "Path": "/api/rooms/{**catch-all}"
        }
      },
      "hotel-rates-route": {
        "ClusterId": "hotel-cluster",
        "Match": {
          "Path": "/api/rates/{**catch-all}"
        }
      },
      "hotel-services-route": {
        "ClusterId": "hotel-cluster",
        "Match": {
          "Path": "/api/roomservices/{**catch-all}"
        }
      },
      "hotel-inventory-route": {
        "ClusterId": "hotel-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "reservations-guests-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/guests/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "reservations-payments-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "reservations-invoices-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/invoices/{**catch-all}"
        }
      },
      "operations-departments-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/departments/{**catch-all}"
        }
      },
      "operations-staff-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/staff/{**catch-all}"
        }
      },
      "operations-reports-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7001/"
          }
        }
      },
      "hotel-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002/"
          }
        }
      },
      "reservations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003/"
          }
        }
      },
      "operations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7004/"
          }
        }
      }
    }
  }
}
